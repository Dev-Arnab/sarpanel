#!/bin/bash --login
#SBATCH --job-name=sarpanel_run
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=2-00:00:00
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
set -euo pipefail

# Processes the scenes assigned to one shard of the manifest.
#
#   mkdir -p logs
#   sbatch --array=0-0 slurm/run_shard.sb configs/local_demo.yaml
#
# Set the array range from n_shards in the config (0 through n_shards-1).
# Aim for 10 to 20 scenes per shard: fewer than that and per-task startup
# (conda, JVM, SNAP) dominates.
#
# Required:
#   SNAP_HOME               directory that contains bin/gpt
# Optional:
#   SARPANEL_ENV            conda environment name or prefix (default: sarpanel)
#   SARPANEL_CONDA_MODULE   module to load before conda activate
#   SARPANEL_SCRATCH        directory for SNAP user dirs and temp files

PROJECT="${SARPANEL_PROJECT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
CONFIG="${1:?usage: sbatch --array=0-N slurm/run_shard.sb <config.yaml>}"
[[ "$CONFIG" = /* ]] || CONFIG="$PROJECT/$CONFIG"

if [[ -z "${SNAP_HOME:-}" ]]; then
  echo "Set SNAP_HOME to the ESA SNAP installation (the directory that contains bin/gpt)." >&2
  exit 1
fi

if [[ -n "${SARPANEL_CONDA_MODULE:-}" ]]; then
  module purge
  module load "$SARPANEL_CONDA_MODULE"
fi
conda activate "${SARPANEL_ENV:-sarpanel}"

export PYTHONPATH="$PROJECT/src:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export PATH="$SNAP_HOME/bin:$PATH"

# A login shell can re-read a profile that still holds an old password.
# Clearing these names lets ~/.earthdata_token win.
unset EARTHDATA_USERNAME EARTHDATA_PASSWORD ASF_USERNAME ASF_PASSWORD

SCRATCH="${SARPANEL_SCRATCH:-${SLURM_TMPDIR:-/tmp}}"
export SNAP_USERDIR="$SCRATCH/snap_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$SNAP_USERDIR/system/var/log"
: > "$SNAP_USERDIR/system/var/log/messages.log"

if [[ -n "${SLURM_TMPDIR:-}" && -d "${SLURM_TMPDIR}" ]]; then
  export TMPDIR="${SLURM_TMPDIR}/sarpanel"
else
  export TMPDIR="$SCRATCH/sarpanel_tmp/task_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
fi
mkdir -p "$TMPDIR"

cleanup() {
  rm -rf "$TMPDIR" "$SNAP_USERDIR"
}
trap cleanup EXIT

# Heap is sized inside the package from SLURM_MEM_PER_NODE. Leave headroom
# for the Python process that still has to hold a scene-sized array.
export PROJ_NETWORK=OFF

echo "host=$(hostname) task=${SLURM_ARRAY_TASK_ID} mem=${SLURM_MEM_PER_NODE:-?}MB tmp=${TMPDIR}"

cd "$PROJECT"
mkdir -p logs
python -m sarpanel.cli run "$CONFIG" --shard "${SLURM_ARRAY_TASK_ID}"
